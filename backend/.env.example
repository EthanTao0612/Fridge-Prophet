# 复制成 .env 后填写。.env 不要提交到 git！

# ---- 应用 ----
DEBUG=true

# ---- 数据库 ----
# 开发期：什么都不用填，默认用 SQLite，文件在 backend/fridge_prophet.db
#
# 上线期：填 Supabase 的连接串。在 Supabase 控制台
#   Project Settings → Database → Connection string → URI
# 把 postgresql:// 改成 postgresql+psycopg://，密码里的特殊字符要 URL 编码
#
# 常驻服务器（我们这种）用 Session pooler，端口 5432：
# DATABASE_URL=postgresql+psycopg://postgres.abcdefgh:你的密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Serverless（Vercel/函数计算）用 Transaction pooler，端口 6543：
# DATABASE_URL=postgresql+psycopg://postgres.abcdefgh:你的密码@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# ⚠️ 结尾的 `?sslmode=require` 别省。
#    Supabase 强制 SSL，而 psycopg 的默认值是 `prefer`（先试 SSL，失败就退回明文）。
#    退回明文会被 Supabase 拒掉，而且报错信息很不直观 ——
#    表现出来就是「有时候连得上、有时候连不上」，最难查。
#    显式写上，连不上就干脆连不上，不会出现半通不通的状态。

# ---- 鉴权（上线必须换掉！）----
SECRET_KEY=change-me-to-a-long-random-string
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"

# ---- AI：阿里云百炼 DashScope ----
# 控制台 https://bailian.console.aliyun.com/ → API-KEY 管理
# 留空则后端自动进入 MOCK 模式（返回演示数据），不影响链路调试
DASHSCOPE_API_KEY=
VISION_MODEL=qwen-vl-max
TEXT_MODEL=qwen-plus

# ---- Supabase Storage（可选）----
# 配好后冰箱照片存 Supabase，不占服务器磁盘，换机器也不丢
# SUPABASE_URL 在 Project Settings → API → Project URL
# SUPABASE_SERVICE_KEY 是 service_role 那个 key，只能放后端，绝对不能写进 App！
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=fridge-photos

# ---- 上传 ----
MAX_UPLOAD_MB=10
